          "id": "YcPn2n0TNdYz6LsJ",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "COMPLETAR: credencial HTTP Header Auth con header 'Authorization' = 'Bearer TU_API_KEY' (platform.openai.com). Body sin '=' inicial, igual que en el TP7."
    },
    {
      "parameters": {
        "jsCode": "const respuesta = $input.first().json;\n\nconst texto = respuesta.choices && respuesta.choices[0]\n  ? respuesta.choices[0].message.content\n  : 'ERROR: no se pudo extraer el texto generado.';\n\nconst previo = $('Preparar Contexto y Prompt').first().json;\n\nreturn [{\n  json: {\n    recordId: previo.recordId,\n    ragIds: previo.ragIds,\n    borradorGenerado: texto\n  }\n}];\n"
      },
