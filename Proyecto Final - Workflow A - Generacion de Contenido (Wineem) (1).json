    {
      "parameters": {
        "jsCode": "const trigger = $('Buscar Ideas Pendientes (Estado = Pendiente)').first().json;\nconst ragItems = $('Buscar Base RAG (Conocimiento)').all();\n\nconst contextoRag = ragItems\n  .map(item => `- ${item.json.Tema}: ${item.json.Contenido}`)\n  .join('\\n');\n\nconst ragIds = ragItems.map(item => item.json.id);\n\nconst promptFinal = `Actua como el redactor de contenido de la marca Wineem (venta de indumentaria).\n\nInformacion de referencia sobre la marca (usala como unica fuente, no inventes datos que no esten aca):\n${contextoRag}\n\nEscribi un posteo corto para redes sociales sobre esta idea:\n\"${trigger['Idea Semilla']}\"`;\n\nreturn [{\n  json: {\n    recordId: trigger.id,\n    ideaSemilla: trigger['Idea Semilla'],\n    contextoRag: contextoRag,\n    ragIds: ragIds,\n    promptFinal: promptFinal,\n    startTime: Date.now()\n  }\n}];\n"
      },
      "id": "45c7f85a-5f12-4dc0-af86-5096e8c82081",
      "name": "Preparar Contexto y Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2816,
        1216
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o-mini\",\n  max_tokens: 500,\n  messages: [\n    {\n      role: \"system\",\n      content: \"Sos el redactor de contenido de la marca Wineem.\"\n    },\n    {\n      role: \"user\",\n      content: $json.promptFinal\n    }\n  ]\n}) }}",
        "options": {}
      },
      "id": "17509d4f-b1a8-4224-8610-032960a0eec7",
      "name": "Generar Contenido con OpenAI",
